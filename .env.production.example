# =====================================================================
#  wacrm — PRODUCTION ENV
#  Copy to /opt/wacrm/.env on the VPS (next to docker-compose.yml).
#  Never commit the real .env — generate strong, unique secrets.
# =====================================================================

# --- Container image (set by CI; override to pin a specific SHA tag) ---
APP_IMAGE=ghcr.io/devdrwt/wacrm:latest

# --- Supabase (Project Settings → API) -------------------------------
# URL + anon key are PUBLIC (inlined into the client bundle by next build).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role key BYPASSES RLS. Used only server-side (webhook,
# automation engine, super-admin actions). Keep strictly secret.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Public site URL (absolute links, OAuth callbacks, OG images) ---
NEXT_PUBLIC_SITE_URL=https://drwt-crm.drwintech.com

# --- WhatsApp token encryption (AES-256-GCM, 32 bytes = 64 hex chars) -
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this orphans every encrypted WhatsApp token — users must
# re-save their settings before they can send again.
ENCRYPTION_KEY=64-char-hex-string

# --- Meta App Secret (Meta for Developers → App Settings → Basic) -----
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# --- Cron shared secret (header x-cron-secret) ------------------------
# The host crontab calls /api/automations/cron and /api/flows/cron with
# this in the x-cron-secret header. Generate: openssl rand -hex 24
AUTOMATION_CRON_SECRET=long-random-string

# --- Email (Resend) — optional ----------------------------------------
# Without RESEND_API_KEY the invitation flow falls back to "Copy link".
# For a verified sender domain configure it in Resend dashboard first;
# otherwise leave EMAIL_FROM on onboarding@resend.dev (Resend's sandbox).
RESEND_API_KEY=re_...
EMAIL_FROM=Drwintech <noreply@drwintech.com>

# ======================================================================
# Baileys pilot side-car (wa-gateway) — INTERNAL ONLY
# ======================================================================
# LEAVE ALL THREE EMPTY on any deployment that serves paying clients.
#
# The gateway drives an unofficial WhatsApp Web connection. It exists so
# Drwintech staff can run demos and end-to-end tests without a WABA. It
# violates WhatsApp's ToS and can get the paired number banned, so it is
# never exposed to clients and never priced. See docs/pilote-baileys.md.
#
# Unset = the pilot is fully off: /api/admin/whatsapp-pilot answers 503,
# and the webhook's gateway signature check fails closed.
#
# Internal URL of the side-car on the compose network.
# WA_GATEWAY_URL=http://wa-gateway:4100
#
# Bearer token the app presents to the gateway. openssl rand -hex 32
# WA_GATEWAY_TOKEN=
#
# HMAC key the gateway signs inbound webhooks with. MUST be identical on
# both sides, and MUST differ from META_APP_SECRET — the whole point is
# that a compromised gateway cannot forge Meta traffic. openssl rand -hex 32
# WA_GATEWAY_SECRET=
#
# How Flows menus are rendered: 'text' (numbered list, works everywhere)
# or 'native' (WhatsApp Web buttons — unreliable, often blank bubbles).
# WA_INTERACTIVE_MODE=text
